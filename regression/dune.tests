(executable
 (name test000)
 (public_name -)
 (modules test000)
 (libraries MiniKanren MiniKanren.Tester)
 (preprocess
  (action
   (run
    %{project_root}/camlp5/pp5+gt+plugins+ocanren+logger+dump.exe
    %{input-file})))
 (preprocessor_deps
  (file %{project_root}/camlp5/pp5+gt+plugins+ocanren+logger+dump.exe)))

(cram
   (applies_to test000)
   (deps ./test000.exe))

